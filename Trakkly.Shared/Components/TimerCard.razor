@using MudBlazor
@using Trakkly.Shared.Models
@implements IDisposable

<MudCard Outlined="true" Class="mud-card-style rounded-lg">
    <MudCardHeader Style="width:100%; justify-content:space-between">
        <MudText Align="Align.Start">Project</MudText>
        <MudIconButton Color="_color"
                       Icon="@Icons.Material.Filled.Edit"
                       aria-label="edit" />
    </MudCardHeader>

    <MudCardMedia Image="images/door.jpg" Height="200" />

    <MudCardContent>
        <MudText Typo="Typo.h5">Name: @Project.Name</MudText>
        <MudText Typo="Typo.h5">ID: @Project.Id</MudText>
        <MudText Typo="Typo.body2">Description: @Project.Description</MudText>
        <MudText Typo="Typo.caption">IsRunning: @Project.IsRunning</MudText>
        <MudText Typo="Typo.body1">Elapsed: @ElapsedDisplay</MudText>

        <MudIconButton Icon="@EvaluateStatus(Project)"
                       Color="Color.Tertiary"
                       OnClick="@(() => ChangeRunningState(Project))"
                       aria-label="start-pause" />

        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                       Color="Color.Error"
                       OnClick="@(() => ResetProject(Project))"
                       aria-label="reset" />
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Text" Color="Color.Tertiary">Share</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Tertiary">Learn more</MudButton>
    </MudCardActions>
</MudCard>

@code {
    private MudBlazor.Color _color = Color.Default;
    private System.Threading.Timer? _timer;

    [Parameter] public TimerProject Project { get; set; } = default!;

    private string ElapsedDisplay => Project?.Elapsed.ToString(@"hh\:mm\:ss\.fff") ?? "00:00:00:000";

    private string EvaluateStatus(TimerProject? project)
    {
        if (project == null)
            return Icons.Material.Filled.Help;

        return project.IsRunning
            ? Icons.Material.Filled.PauseCircle
            : Icons.Material.Filled.PlayCircle;
    }

    private void ChangeRunningState(TimerProject project)
    {
        if (project.IsRunning)
        {
            project.StopTimer();
        }
        else
        {
            project.StartTimer();
        }

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (Project?.IsRunning == true)
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1);
    }
    
    private void ResetProject(TimerProject project)
    {
        project.ResetTimer();
        StateHasChanged();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
