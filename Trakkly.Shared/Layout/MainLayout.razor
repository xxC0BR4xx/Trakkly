@using MudBlazor
@inherits LayoutComponentBase
@inject ProjectManager ProjectManager

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />


<MudLayout>
    <MudAppBar Elevation="1" Class="app-header">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="font-weight-bold ms-2">Trakkly</MudText>
        <MudSpacer />

        <MudSwitch @bind-Value="_isDarkMode" Color="Color.Default" Class="ma-2" T="bool" Label="Dark Mode" />
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Default" Link="https://github.com/xxC0BR4xx" Target="_blank" />
    </MudAppBar>

    <MudAppBar Bottom="true" Elevation="1" Class="app-footer">
        <MudToolBar Class="w-100 justify-content-center" Style="gap: 2rem;">
            <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink href="/Summary" Icon="@Icons.Material.Filled.Analytics">Statistics</MudNavLink>
            <MudNavLink href="/Settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudToolBar>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<style>
    ::deep .app-header {
        background: linear-gradient(90deg, var(--mud-palette-primary) 0%, rgba(0,0,0,0.05) 100%);
    }

    ::deep .app-footer {
        border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    ::deep .mud-main-content {
        padding: 0;
    }
</style>



@code {
    private bool _drawerOpen = false;
    private bool _isDarkMode = false;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        ProjectManager.OnProjectsChanged += StateHasChanged;
        if (!ProjectManager.IsInitialized)
            await ProjectManager.LoadAsync();
    }

    public void Dispose()
    {
        ProjectManager.OnProjectsChanged -= StateHasChanged;
    }
}